# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (Atlas or local) - paste your own connection string
MONGODB_URI=mongodb://127.0.0.1:27017/atelier-maison

# Auth - use a long random string (see README for a command to generate one)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Initial admin created by "npm run seed" - choose your own values
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: throwaway database used ONLY by integration tests
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/atelier-maison-test
